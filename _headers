/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.paypal.com https://www.paypalobjects.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.paypalobjects.com; connect-src 'self' https://www.paypal.com https://www.paypalobjects.com https://api-m.paypal.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://www.paypal.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# Long-lived caching for immutable static assets
/logo.webp
  Cache-Control: public, max-age=31536000, immutable

/founder-photo.webp
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=31536000, immutable

/client-logo-mineshouten.jpeg
  Cache-Control: public, max-age=31536000, immutable

/work-w2-cover.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon-16.png
  Cache-Control: public, max-age=604800

/favicon-32.png
  Cache-Control: public, max-age=604800

/favicon-48.png
  Cache-Control: public, max-age=604800

/favicon-180.png
  Cache-Control: public, max-age=604800

/favicon-192.png
  Cache-Control: public, max-age=604800

/favicon-512.png
  Cache-Control: public, max-age=604800

# Crawler files: short cache so updates propagate quickly
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/manifest.json
  Cache-Control: public, max-age=86400

# IndexNow key file must be served as plain text
/c96a412c5d41125143ea5fa42129051f.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/terms.pdf
  Content-Type: application/pdf
  Cache-Control: public, max-age=3600
  Content-Disposition: inline; filename="HexaPoint-Terms-of-Service.pdf"
